# pr-shepherd credentials for scripts/deploy.sh. Copy to deploy.env (gitignored) and fill in:
#   cp deploy.env.example deploy.env && chmod 600 deploy.env
# Never commit deploy.env. The values are read by scripts/deploy.sh and passed to InstaCloud as secrets.

# GitHub fine-grained PAT (github.com/settings/personal-access-tokens/new), resource owner = your org.
# Repository permissions: Contents, Pull requests, Issues: read and write; Commit statuses, Actions: read-only;
# Workflows: no access. It acts as you.
GH_TOKEN=

# Slack app (see README "Slack app"): Bot User OAuth Token and an App-Level Token with connections:write.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Claude: set exactly one. `claude setup-token` prints a one-year subscription token; or an Anthropic API key.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# InstaCloud project to create when this checkout isn't linked to one yet (not a secret; default: bot.name).
# --project on the command line wins.
INSTA_PROJECT=
